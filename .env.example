# Compose topology. Copy to .env through ./install and keep it private.
RECORDBENCH_COMPOSE_PROJECT=recordbench
RECORDBENCH_IMAGE_NAMESPACE=recordbench
RECORDBENCH_RELEASE_ID=dev
RECORDBENCH_UID=1000
RECORDBENCH_GID=1000

# Host paths may live on local storage or a host-mounted NAS. Do not use a
# broad directory or the root of a share.
RECORDBENCH_CONFIG_ROOT=/srv/recordbench/config
RECORDBENCH_SECRETS_ROOT=/srv/recordbench/secrets
RECORDBENCH_RUNTIME_ROOT=/srv/recordbench/runtime
RECORDBENCH_STORAGE_ROOT=/srv/recordbench/matter-storage
RECORDBENCH_TRANSCRIPTION_ROOT=/srv/recordbench/transcription
RECORDBENCH_STATE_ROOT=/srv/recordbench/state
RECORDBENCH_MODEL_ROOT=/srv/recordbench/models

# HTTPS is loopback-only until the operator deliberately selects a LAN bind.
RECORDBENCH_BIND_ADDRESS=127.0.0.1
RECORDBENCH_HTTPS_PORT=8443
RECORDBENCH_SERVER_NAME=recordbench.example.test
RECORDBENCH_TLS_CERT=/srv/recordbench/tls/tls.crt
RECORDBENCH_TLS_KEY=/srv/recordbench/tls/tls.key
RECORDBENCH_GATEWAY_UPSTREAM=app:8786

# Portable one-GPU assignment. Learned embedding and reranking default to CPU;
# generation and transcription are co-resident on GPU 0 with conservative
# memory limits. There is no cross-service GPU scheduler: validate this shape
# on the exact card before staff use. Automatic installation separates services
# when more devices are available.
RECORDBENCH_GENERATOR_GPU=0
RECORDBENCH_GENERATOR_TENSOR_PARALLEL=1
RECORDBENCH_RETRIEVAL_GPU=0
RECORDBENCH_TRANSCRIPTION_GPU=0
RECORDBENCH_RETRIEVAL_DEVICE=cpu

# Pinned default model portfolio. Change only through a reviewed model profile.
RECORDBENCH_GENERATOR_MODEL_ID=Qwen/Qwen3.5-4B
RECORDBENCH_GENERATOR_REVISION=851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a
RECORDBENCH_GENERATOR_SERVED_NAME=recordbench-qwen35-4b
RECORDBENCH_GENERATOR_DTYPE=bfloat16
RECORDBENCH_GENERATOR_CONTEXT=16384
RECORDBENCH_GENERATOR_SEQUENCES=4
RECORDBENCH_GENERATOR_GPU_UTILIZATION=0.50
RECORDBENCH_EMBEDDING_MODEL=ibm-granite/granite-embedding-english-r2
RECORDBENCH_EMBEDDING_REVISION=47ea694b257b703fee9253d75c2b1f2985180498
RECORDBENCH_RERANKER_MODEL=Alibaba-NLP/gte-reranker-modernbert-base
RECORDBENCH_RERANKER_REVISION=f7481e6055501a30fb19d090657df9ec1f79ab2c
